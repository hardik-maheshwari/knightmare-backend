# Copy to .env for local dev. On a host (Render/Railway/Fly), set these in its dashboard.

# Long random string; signs JWTs. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
DEBUG=false

# Any of these work: postgres://, postgresql://, postgresql+asyncpg://
# sslmode=require (Neon, Render external URLs) is translated for asyncpg automatically.
# Neon: use the DIRECT connection string, not the "-pooler" host (pgbouncer
# transaction mode breaks asyncpg prepared statements).
DATABASE_URL=postgresql://user:password@host:5432/knightmare?sslmode=require

# false = single instance, in-memory pub/sub + tickets + rate limits (no Redis needed).
#         Run exactly ONE instance/worker in this mode.
# true  = Redis-backed, required to scale beyond one instance.
USE_REDIS=false
# REDIS_URL=rediss://default:password@host:6379
# RATELIMIT_STORAGE_URI=rediss://default:password@host:6379

# Comma-separated frontend origins, e.g. https://knightmare.vercel.app ("*" if unset)
CORS_ALLOW_ORIGINS=*

# Port to listen on; most hosts inject this automatically.
# PORT=10000
